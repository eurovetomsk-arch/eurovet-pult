<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ru.eurovet.recovery</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOME__/.eurovet/eurovet-recovery.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>15</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.eurovet/launchd.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.eurovet/launchd.log</string>
</dict>
</plist>
